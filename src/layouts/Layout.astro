---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const manager = `${base}/marcadores/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0e" />
    <link rel="icon" type="image/svg+xml" href={`${base}/atajo.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="site-header shell">
      <a class="brand" href={home} aria-label="Atajo, inicio">
        <span class="brand-symbol"><Icon name="bookmark" size={21} /></span>
        Atajo<span class="brand-period">.</span>
      </a>
      <nav aria-label="Navegación principal">
        {page === 'home' ? (
          <div class="landing-nav"><a href="#explorar">Explorar</a><a href="#como-funciona">Cómo funciona</a></div>
        ) : <a href={home}>Inicio</a>}
        <a class="nav-main" href={manager} aria-current={page === 'manager' ? 'page' : undefined}>Mis marcadores</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer shell">
      <a class="brand footer-brand" href={home} aria-label="Atajo, inicio">
        <span class="brand-symbol"><Icon name="bookmark" size={17} /></span>
        Atajo<span class="brand-period">.</span>
      </a>
      <span><Icon name="shield" size={16} /> Guardado en este navegador</span>
    </footer>
  </body>
</html>
